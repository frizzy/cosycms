{
  "name": "cosycms",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:admin": "vite",
    "build:admin": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cosycms --local",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "svelte-check && tsc --noEmit",
    "deploy:staging": "vite build && wrangler d1 migrations apply cosycms-staging --env staging --remote && wrangler deploy --env staging"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "marked": "^18.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
